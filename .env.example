# Cointier 環境変数 — 実値は Coolify env panel で設定 (V ルール準拠)
# 値の取得・参照は ~/.claude/projects/D--dev-cointierai/memory/reference_api_keys.md を参照

# ========== Supabase (Cointier 専用プロジェクト) ==========
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=cointier
# Direct DB URL for scripts/apply-migrations.ts — Supabase Dashboard →
# Settings → Database → Connection string (URI).
SUPABASE_DB_URL=

# ========== OpenRouter (LLM ゲートウェイ統一) ==========
# 既存メモリ参照: appexxme/memory/reference_api_keys.md:452
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://cointier.ai
OPENROUTER_APP_NAME=Cointier
# デフォルトモデル (model: 'deepseek/deepseek-v4-pro' 推奨)
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ========== Crypto データソース ==========
COINGECKO_API_KEY=
# COINGECKO_API_KEY_TIER=pro          # 'pro' のみ・無料 Demo は省略
CRYPTORANK_API_KEY=
ROOTDATA_API_KEY=
TOKEN_TERMINAL_API_KEY=
TOKENOMIST_API_KEY=
LUNARCRUSH_API_KEY=
# 無料・キー不要: DeFiLlama / DEXScreener / Hyperliquid

# ========== 未統合 free API 追加 (2026-05-13 SSOT 拡張) ==========
CRYPTOPANIC_API_KEY=                   # news (100 req/h 無料)
COINGLASS_API_KEY=                     # derivatives history (任意・無料枠は薄い)
MESSARI_API_KEY=                       # onchain + team profile (任意で leniency)
GITHUB_TOKEN=                          # developer activity (5K req/h)
ETHERSCAN_V2_KEY=                      # multichain holders (5 req/s 100K/day)
BITQUERY_API_KEY=                      # EVM holders fallback (100K points/月)
DAPPRADAR_API_KEY=                     # dApp / airdrops (任意)

# ========== Meilisearch (任意・self-host で typo tolerance) ==========
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=                   # combined read/write key (簡易)
MEILISEARCH_ADMIN_KEY=                 # 分離する場合の write key
MEILISEARCH_SEARCH_KEY=                # 分離する場合の read key

# ========== Stripe (Cointier 用 product) ==========
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# ========== Privy (ウォレット統合・M3-M4 で再導入予定) ==========
# 注: @privy-io/react-auth@2.0.0 は内部 Solana 依存破綻のため M0 で削除
# (peerDeps @solana-program/system@^0.7.0 vs transitive ^0.10.0).
# M3 再導入時は互換バージョン (例 v1.x) または `--legacy-peer-deps` を検討
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ========== Hyperliquid Builder Fee (M4+) ==========
NEXT_PUBLIC_HYPERLIQUID_BUILDER_ADDRESS=
HYPERLIQUID_BUILDER_PRIVATE_KEY=

# ========== Wallet Connect (M1 wagmi 接続用) ==========
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ========== Admin 管理画面 allowlist (カンマ区切り) ==========
ADMIN_EMAILS=apple.info.9124@gmail.com

# ========== Cron 認証 (Coolify env から自動生成済) ==========
CRON_SECRET=

# ========== Slack (既存メモリ参照: appexxme/memory:272) ==========
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C0B1JJ1L276

# ========== n8n / Dify (既存メモリ参照) ==========
N8N_API_KEY=
N8N_WEBHOOK_BASE=
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1

# ========== Cloudflare R2 (既存メモリ参照: appexxme/memory:401) ==========
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=cointier-assets
CF_R2_ENDPOINT=

# ========== 内部設定 ==========
NEXT_PUBLIC_SITE_URL=https://cointier.ai
NODE_ENV=production
